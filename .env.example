# Copy to .env and fill in what you need. Only DATABASE_URL and PORT are required to run locally.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Postgres. Local: docker compose. Hosted: paste the Supabase connection string here.
DATABASE_URL=postgres://opensquad:opensquad@localhost:5432/opensquad

# Storage. "local" writes to .data/storage. "supabase" uses Supabase Storage.
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=.data/storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=avatars

# Auth (Clerk). Leave empty to run with auth disabled in development.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Providers. All optional until the corresponding plugin is implemented.
OPENROUTER_API_KEY=
DAYTONA_API_KEY=
MEM0_API_KEY=
AGENTMAIL_API_KEY=
VAPI_API_KEY=
COMPOSIO_API_KEY=
TRIGGER_SECRET_KEY=
