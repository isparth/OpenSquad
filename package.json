{
  "name": "opensquad",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @opensquad/api dev",
    "dev:desktop": "pnpm --filter @opensquad/desktop dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @opensquad/db generate",
    "db:migrate": "pnpm --filter @opensquad/db migrate",
    "db:studio": "pnpm --filter @opensquad/db studio"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.0"
  }
}
