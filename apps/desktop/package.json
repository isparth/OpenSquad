{
  "name": "@opensquad/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "OpenSquad desktop app",
  "main": "./out/main/index.js",
  "author": "OpenSquad",
  "homepage": "https://github.com/parthsharmapoudel/OpenSquad",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "package": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@opensquad/core": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^42.10.0",
    "electron-builder": "^26.15.0",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
