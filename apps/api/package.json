    "@opensquad/db": "workspace:*",
    "@opensquad/plugin-agentmail": "workspace:*",
    "@opensquad/plugin-composio": "workspace:*",
    "@opensquad/plugin-daytona": "workspace:*",
    "@opensquad/plugin-local-storage": "workspace:*",
    "@opensquad/plugin-mem0": "workspace:*",
    "@opensquad/plugin-openrouter": "workspace:*",
    "@opensquad/plugin-supabase-storage": "workspace:*",
    "@opensquad/plugin-trigger": "workspace:*",
    "@opensquad/plugin-vapi": "workspace:*",
    "drizzle-orm": "^0.44.7",
    "fastify": "^5.4.0",
    "fastify-plugin": "^5.0.0",
    "fastify-type-provider-zod": "^5.0.0",
    "zod": "^4.5.4"
